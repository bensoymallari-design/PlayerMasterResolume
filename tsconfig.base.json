{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@playermaster/shared": ["packages/shared/src/index.ts"],
      "@playermaster/shared/*": ["packages/shared/src/*"],
      "@playermaster/resolume": ["packages/resolume/src/index.ts"],
      "@playermaster/resolume/*": ["packages/resolume/src/*"]
    }
  }
}
