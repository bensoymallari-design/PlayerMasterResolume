{
  "name": "playermaster",
  "version": "0.1.0",
  "private": true,
  "description": "PlayerMaster digital signage platform monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @playermaster/cms",
    "dev:player": "npm run dev --workspace @playermaster/player",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @playermaster/cms",
    "prisma:migrate": "npm run prisma:migrate --workspace @playermaster/cms"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "@hono/node-server": "^1.19.13",
    "next": {
      "postcss": "^8.5.15"
    }
  }
}
