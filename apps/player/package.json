{
  "name": "@playermaster/player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main/main.ts",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:local": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-builder",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "build": {
    "appId": "com.playermaster.player",
    "productName": "PlayerMaster Player",
    "files": [
      "dist/**/*"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "${env.AUTO_UPDATE_URL}"
      }
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron": "^42.5.0",
    "electron-updater": "^6.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
