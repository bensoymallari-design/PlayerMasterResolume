# PlayerMaster CMS - local network only
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playermaster"
JWT_SECRET="replace-with-a-long-random-local-secret"
MEDIA_UPLOAD_DIR="./storage/media"

# Keep local-only protection enabled unless you intentionally deploy publicly.
LOCAL_NETWORK_ONLY="true"

# Comma-separated CMS origins allowed for Socket.IO.
# Add your CMS machine LAN address after you find it, e.g. http://192.168.1.50:3000
SOCKET_CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Optional initial admin used by `npm run prisma:seed`.
SEED_ADMIN_NAME="Local Admin"
SEED_ADMIN_EMAIL="admin@playermaster.local"
SEED_ADMIN_PASSWORD="change-me-local-only"
